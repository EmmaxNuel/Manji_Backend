# Django configuration for Manji development
# Copy to .env and fill in real values.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - SQLite for development (PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3

# CORS - origins that the React dev server is allowed on
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email (console backend for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@manji.io

# --- AI integrations ------------------------------------------------------
# Image generation. Default provider used when none is sent by the client.
# Supported: dalle, stability, leonardo, local (dev placeholder, see below).
AI_IMAGE_PROVIDER_DEFAULT=dalle

# Provider API keys. Leave empty to disable that provider.
AI_OPENAI_API_KEY=
AI_OPENAI_IMAGE_MODEL=dall-e-3
AI_STABILITY_API_KEY=
AI_LEONARDO_API_KEY=

# Text / idea generation - OpenAI-compatible chat completions endpoint.
# Examples:
#   OpenAI:      base https://api.openai.com/v1,  model gpt-4o-mini
#   OpenRouter:  base https://openrouter.ai/api/v1
#   Ollama:      base http://localhost:11434/v1 (no key), model llama3
AI_TEXT_API_KEY=
AI_TEXT_BASE_URL=https://api.openai.com/v1
AI_TEXT_MODEL=gpt-4o-mini

# In development only, if no image provider key is set, Manji can render real
# placeholder images locally with Pillow. Set to False to disable.
AI_ALLOW_LOCAL_PLACEHOLDER=True

# Per-user daily quotas.
AI_IMAGE_QUOTA_DAILY=20
AI_TEXT_QUOTA_DAILY=30

# Largest single asset a creator may upload to the project library (MB).
ASSET_MAX_UPLOAD_MB=100

# --- Manji AI chat (Phase 1) ------------------------------------------------
# Chat provider: "openai" (any OpenAI-compatible /chat/completions endpoint),
# "openrouter" (uses OPENROUTER_API_KEY), or "gemini" (uses GEMINI_API_KEY).
# The chat reuses AI_TEXT_API_KEY / AI_TEXT_BASE_URL when provider is "openai".
AI_CHAT_PROVIDER=openai
# Optional second provider tried automatically when the primary errors, e.g.
#   AI_CHAT_PROVIDER=gemini
#   AI_CHAT_FALLBACK_PROVIDER=openrouter
# Providers are interchangeable, so an outage never hard-fails a chat turn.
AI_CHAT_FALLBACK_PROVIDER=
# Optional; defaults to AI_TEXT_MODEL when empty.
AI_CHAT_MODEL=
# Max tokens per chat reply.
AI_CHAT_MAX_TOKENS=800
# How many previous turns to include as context for the model.
AI_CHAT_HISTORY_MESSAGES=12
# Max characters of the current draft sent to the model.
AI_CHAT_CONTEXT_MAX_CHARS=8000

# --- Manji AI chat providers (Phase 4) ---------------------------------------
# Google Gemini. Set GEMINI_API_KEY to enable the "gemini" provider.
GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-1.5-flash

# OpenRouter. Set OPENROUTER_API_KEY to enable the "openrouter" provider.
OPENROUTER_API_KEY=
AI_OPENROUTER_MODEL=