# Django configuration for Manji PRODUCTION
# Copy to .env.prod and fill in real values.
# NEVER commit this file with real secrets.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=manji.io,www.manji.io,api.manji.io
CSRF_TRUSTED_ORIGINS=https://manji.io,https://www.manji.io
CORS_ALLOWED_ORIGINS=https://manji.io,https://www.manji.io

# Database - PostgreSQL for production
DATABASE_URL=postgresql://manji:secure-password@postgres:5432/manji

# Redis for caching/sessions
REDIS_URL=redis://redis:6379/0

# Email (production) - Choose one:
# Option A: Gmail API (OAuth2) - recommended for transactional emails
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token

# Option B: SMTP (SendGrid, etc.)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@manji.io

# --- Gmail API (OAuth2) for transactional emails ---------------------------
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token

# --- Frontend URL (for email links) ----------------------------------------
FRONTEND_URL=https://manji.io

# --- AI integrations ------------------------------------------------------
AI_IMAGE_PROVIDER_DEFAULT=dalle
AI_OPENAI_API_KEY=your-openai-api-key
AI_OPENAI_IMAGE_MODEL=dall-e-3
AI_STABILITY_API_KEY=your-stability-api-key
AI_LEONARDO_API_KEY=your-leonardo-api-key

AI_TEXT_API_KEY=your-openai-api-key
AI_TEXT_BASE_URL=https://api.openai.com/v1
AI_TEXT_MODEL=gpt-4o-mini

AI_ALLOW_LOCAL_PLACEHOLDER=False

AI_IMAGE_QUOTA_DAILY=20
AI_TEXT_QUOTA_DAILY=30

ASSET_MAX_UPLOAD_MB=100

# Manji AI chat
AI_CHAT_PROVIDER=openai
AI_CHAT_FALLBACK_PROVIDER=openrouter
AI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_MAX_TOKENS=800
AI_CHAT_HISTORY_MESSAGES=12
AI_CHAT_CONTEXT_MAX_CHARS=8000

# Manji AI chat providers
GEMINI_API_KEY=your-gemini-api-key
AI_GEMINI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=your-openrouter-api-key
AI_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- AWS S3 / Object Storage -----------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=manji-media-prod
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=cdn.manji.io

# --- Caddy / HTTPS ---------------------------------------------------------
CADDY_EMAIL=admin@manji.io

# --- Windows Release (optional) --------------------------------------------
# MANJI_RELEASE_VERSION=1.0.0
# MANJI_DOWNLOAD_URL=https://manji.io/downloads/MANJI-Setup-1.0.0.exe
# MANJI_PORTABLE_DOWNLOAD_URL=https://manji.io/downloads/MANJI-1.0.0-portable.exe
# MANJI_RELEASE_DATE=2026-01-15
# MANJI_INSTALLER_SIZE_BYTES=123456789
# MANJI_PORTABLE_SIZE_BYTES=98765432
# MANJI_SUPPORTED_WINDOWS=Windows 10 version 1903 or later (64-bit)
# MANJI_CHANGELOG=Initial release,Added AI co-author,Improved animation timeline

# --- YouTube OAuth (optional) ----------------------------------------------
# YOUTUBE_CLIENT_ID=your-youtube-client-id
# YOUTUBE_CLIENT_SECRET=your-youtube-client-secret